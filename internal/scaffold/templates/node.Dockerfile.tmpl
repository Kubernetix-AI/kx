# Written by kx deploy for {{.Label}}.
FROM {{.Image}}
WORKDIR /app
{{- if .CopyFirst}}
COPY {{join .CopyFirst}} ./
{{- range .Install}}
RUN {{.}}
{{- end}}
COPY . .
{{- else}}
COPY . .
{{- range .Install}}
RUN {{.}}
{{- end}}
{{- end}}
{{- range .Build}}
RUN {{.}}
{{- end}}
ENV PORT=8080 HOST=0.0.0.0
EXPOSE 8080
# Some hosts refuse containers that run as root, and can only check a numeric user.
USER 1000
CMD {{exec .Start}}
