# Written by kx deploy for {{.Label}}.
FROM {{.Image}}
WORKDIR /app
{{- if .CopyFirst}}
COPY {{join .CopyFirst}} ./
{{- range .Install}}
RUN {{.}}
{{- end}}
COPY . .
{{- else}}
COPY . .
{{- range .Install}}
RUN {{.}}
{{- end}}
{{- end}}
{{- range .Build}}
RUN {{.}}
{{- end}}
ENV PORT=8080 PYTHONUNBUFFERED=1
EXPOSE 8080
# Some hosts refuse containers that run as root, and can only check a numeric user.
RUN useradd --uid 10001 --create-home app
USER 10001
CMD {{exec .Start}}
